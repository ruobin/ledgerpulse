# APP_DOMAIN is passed in by docker-compose (set it in .env), e.g. ledgerpulse.yourdomain.com.
# Caddy obtains and renews a Let's Encrypt certificate for it automatically.
# It defaults to localhost (served with Caddy's internal CA) for local testing.
# Sign-in is enforced by the app itself (APP_PASSWORD, see src/middleware.ts).
{$APP_DOMAIN:localhost} {
    encode gzip zstd
    reverse_proxy web:3000

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
