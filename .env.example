# AI provider: OpenAI by default. Everything in this section can also be edited in the Admin
# Console (/admin), whose saved values take precedence. The OPENAI_* names keep working; the
# LLM_* names win over them and also cover OpenAI-compatible API gateways.
OPENAI_API_KEY=
# Model per task (README: "Choosing models"):
#   extraction = precise, strict JSON-schema output, long context
#   analysis   = strongest instruction-following you can afford (defaults to the extraction model)
#   research   = fast and cheap, must support the chosen web search provider
OPENAI_MODEL=gpt-4.1-mini
# LLM_ANALYSIS_MODEL=gpt-4.1
OPENAI_RESEARCH_MODEL=gpt-4.1-mini

# Optional: route model calls through an OpenAI-compatible gateway (OpenRouter, LiteLLM,
# Cloudflare AI Gateway, Azure OpenAI v1, Helicone, Portkey, ...). Wrap JSON in single quotes.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_HEADERS='{"HTTP-Referer":"https://ledgerpulse.yourdomain.com"}'
# LLM_MODEL=openai/gpt-4.1-mini
# LLM_RESEARCH_MODEL=openai/gpt-4.1-mini:online

# Web search for research (README: "Web search providers"):
#   openai (default) = OpenAI's hosted search tool (OpenAI or pass-through gateways)
#   model            = the research model's own search (e.g. OpenRouter :online models)
#   brave            = Brave Search API; works with any model provider
# WEB_SEARCH_PROVIDER=brave
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_ENDPOINT=news
# BRAVE_SEARCH_COST_PER_1K=0

# Prices for models the built-in cost table doesn't know (USD per 1M tokens; optional searchPer1k)
# LLM_PRICING='{"vendor/model":{"input":3,"output":15}}'

# Gmail OAuth2 Configuration (Google Cloud Console -> Web Application OAuth Client)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
IBKR_GMAIL_QUERY=from:donotreply@interactivebrokers.com subject:"Daily Activity Statement" has:attachment filename:pdf

# 32-byte hex encryption key for OAuth refresh tokens at rest (generate with: openssl rand -hex 32).
# Required in production; changing it later means reconnecting Gmail.
TOKEN_ENCRYPTION_KEY=

# Access control: HTTP Basic auth for every page and API route (src/middleware.ts).
# Required in production; without APP_PASSWORD a production server answers 503.
APP_USERNAME=admin
APP_PASSWORD=
# Set to true ONLY when an upstream proxy (Cloudflare Access, Tailscale, oauth2-proxy, ...)
# already authenticates every request.
APP_AUTH_DISABLED=false

# Application & Multi-Tenant Defaults
APP_URL=http://localhost:3000
# Public hostname that Caddy serves and provisions TLS for (docker-compose deployments only)
APP_DOMAIN=
DATA_DIR=./data
DEFAULT_USER_ID=usr_demo_owner
DEFAULT_TIMEZONE=America/New_York
# Worker poll interval (minimum 5000). Schedules run on their cron expression, not on every poll.
WORKER_POLL_INTERVAL_MS=60000
